{
  "name": "dot-grants-mcp-server",
  "version": "1.0.0",
  "description": "MCP server providing tools for DOT grant applicants to search opportunities, check eligibility, and track deadlines",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:web": "node dist/web-index.js",
    "dev:web": "tsx watch src/web-index.ts",
    "update-grants": "node dist/data/update-grants-cli.js",
    "test": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "test:run": "vitest run",
    "nofo:ingest": "tsx src/nofo/ingest/cli.ts",
    "nofo:extract": "tsx src/nofo/extraction/cli.ts",
    "nofo:eval": "tsx src/nofo/eval/run-eval.ts",
    "nofo:assess": "tsx src/nofo/assessment/cli.ts"
  },
  "keywords": [
    "mcp",
    "grants",
    "dot",
    "transportation",
    "government"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "axios": "^1.7.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.0",
    "express-rate-limit": "^8.7.1",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "playwright": "^1.64.1",
    "unzipper": "^0.10.0",
    "xml2js": "^0.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.14.0",
    "@types/unzipper": "^0.10.0",
    "@types/xml2js": "^0.4.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
