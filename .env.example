# SAM.gov API Key (REQUIRED)
# Get your free API key from: https://open.gsa.gov/api/get-opportunities-public-api/
# 1. Create account at SAM.gov
# 2. Navigate to your profile
# 3. Copy your API key from the API section
SAM_API_KEY=your_api_key_here

# Rate Limits (optional, defaults shown)
# Number of API requests allowed per day
SAM_RATE_LIMIT_REQUESTS=100
# Time window in milliseconds (86400000 = 24 hours)
SAM_RATE_LIMIT_WINDOW_MS=86400000

# Cache Settings (optional)
# Directory for caching API responses
CACHE_DIR=.cache
# Cache TTL in milliseconds
CACHE_ASSISTANCE_TTL_MS=604800000   # 7 days for program listings
CACHE_OPPORTUNITIES_TTL_MS=21600000  # 6 hours for current opportunities
CACHE_AWARDS_TTL_MS=2592000000       # 30 days for historical awards

# Logging Level (optional)
# Options: debug | info | warn | error
LOG_LEVEL=info

# Web Server Configuration (optional)
# Port for web interface
WEB_PORT=3000
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Data Source (optional, default: mock)
# Options:
#   mock  - 5 built-in sample grants, no API calls, no key needed (default)
#   api   - Live SAM.gov API (requires SAM_API_KEY)
#   local - Downloaded XML extract, no rate limits (run `npm run update-grants` first)
DATA_SOURCE=local

# Anthropic API Key (REQUIRED for the chat feature at /chat.html, optional otherwise)
# Get your key from: https://console.anthropic.com/
# Everything else (search/eligibility/deadlines pages and the MCP server)
# works fine without this set.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Model used for the chat feature (optional, default shown)
ANTHROPIC_MODEL=claude-sonnet-5
# Model used for offline NOFO requirements extraction (optional; defaults to ANTHROPIC_MODEL).
# A stronger model can be used here without changing the chat model.
# ANTHROPIC_EXTRACTION_MODEL=
# Max tokens per chat response (optional, default shown)
ANTHROPIC_MAX_TOKENS=1024
# Optional: route Anthropic API calls through a corporate gateway/proxy
# instead of the public api.anthropic.com (e.g. an internal LLM gateway
# that issues short-lived virtual keys). Leave unset for a normal
# Anthropic API key.
ANTHROPIC_BASE_URL=

# Chat Rate Limit (optional, defaults shown)
# Protects against runaway Anthropic API spend from the public chat box
CHAT_RATE_LIMIT_REQUESTS=10
CHAT_RATE_LIMIT_WINDOW_MS=60000

# Simpler.Grants.gov (NOFO opportunity ingestion; only the `npm run nofo:ingest` CLI needs it)
# Create a key at https://simpler.grants.gov/developers (sign-in via Login.gov).
# Keep it in your local .env only. Never commit it.
SIMPLER_GRANTS_API_KEY=your_simpler_grants_api_key_here
# Optional overrides (defaults shown). The base URL must be https.
# SIMPLER_GRANTS_BASE_URL=https://api.simpler.grants.gov
# SIMPLER_TIMEOUT_MS=30000
# SIMPLER_MAX_RETRIES=3

# NOFO opportunity packages (optional, defaults shown)
# Where ingested opportunity packages are stored (git-ignored by default)
# NOFO_DATA_DIR=data/opportunities
# Per-file and per-package download caps in bytes (50 MB / 200 MB)
# NOFO_MAX_DOWNLOAD_BYTES=52428800
# NOFO_MAX_PACKAGE_BYTES=209715200
